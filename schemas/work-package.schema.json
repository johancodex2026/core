{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.johan.ia.br/schemas/work-package.schema.json",
  "title": "Core V5 Work Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "change_class",
    "objective",
    "non_objectives",
    "baseline_commit",
    "requirements",
    "invariants",
    "risks",
    "tests",
    "execution_steps",
    "stop_conditions",
    "promotion_target"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^WP-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "status": {
      "enum": [
        "IDEA",
        "FRAMED",
        "SPECIFIED",
        "REVIEWED",
        "READY",
        "EXECUTING",
        "VERIFYING",
        "PROMOTION_CANDIDATE",
        "PROMOTED",
        "HOLD",
        "REJECTED",
        "SUPERSEDED",
        "ROLLED_BACK",
        "ESCAPED_DEFECT"
      ]
    },
    "change_class": { "enum": ["D0", "D1", "D2", "D3", "D4"] },
    "objective": { "type": "string", "minLength": 1 },
    "non_objectives": { "type": "array", "items": { "type": "string" } },
    "baseline_commit": { "type": "string", "minLength": 7 },
    "promotion_target": {
      "enum": ["repository_only", "shadow", "canary", "runtime", "memory_candidate", "canonical_memory", "identity", "other"]
    },
    "runtime_effect": { "enum": ["none", "shadow", "canary", "active"] },
    "memory_effect": { "enum": ["none", "proposal", "candidate", "canonical"] },
    "privacy_class": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "authority"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "authority": { "type": "string" },
          "freshness": { "type": "string" },
          "conflicts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "acceptance", "tests"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" },
          "statement": { "type": "string" },
          "source": { "type": "string" },
          "acceptance": { "type": "string" },
          "tests": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^INV-[A-Z0-9-]+$" },
          "statement": { "type": "string" },
          "tests": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^ASM-[A-Z0-9-]+$" },
          "statement": { "type": "string" },
          "impact_if_false": { "type": "string" },
          "validation": { "type": "string" },
          "status": { "enum": ["OPEN", "VALIDATED", "REJECTED", "ACCEPTED_RISK"] }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "control"],
        "properties": {
          "id": { "type": "string", "pattern": "^RISK-[A-Z0-9-]+$" },
          "statement": { "type": "string" },
          "control": { "type": "string" },
          "residual": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^TST-[A-Z0-9-]+$" },
          "type": { "type": "string" },
          "expected": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "execution_steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rollback": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "receipts": { "type": "array", "items": { "type": "string" } }
  }
}
