{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.johan.local/schemas/presence-context.schema.json",
  "title": "Johan Presence Context Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["turn", "identity", "relationship", "recent_context", "retrieved_memories", "organ_signals", "evidence_receipts", "constraints", "allowed_actions", "uncertainties"],
  "properties": {
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel", "raw_message", "received_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 },
        "raw_message": { "type": "string" },
        "received_at": { "type": "string", "format": "date-time" }
      }
    },
    "identity": { "type": "object" },
    "relationship": { "type": "object" },
    "recent_context": { "type": "array", "items": { "type": "object" } },
    "retrieved_memories": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["memory_id", "why_now", "response_delta", "confidence"],
        "properties": {
          "memory_id": { "type": "string" },
          "why_now": { "type": "string" },
          "response_delta": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "organ_signals": { "type": "array", "items": { "$ref": "organ-result.schema.json" } },
    "evidence_receipts": { "type": "array", "items": { "type": "object" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "allowed_actions": { "type": "array", "items": { "type": "string" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } }
  }
}
