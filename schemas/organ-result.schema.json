{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.johan.local/schemas/organ-result.schema.json",
  "title": "Core V5 Organ Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "organ", "status", "observations", "evidence_refs", "confidence", "risk_level", "constraints", "expires_at"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "organ": { "type": "string", "enum": ["JWB", "JSL", "JRL", "SGPJ", "Agenda", "JSU"] },
    "status": { "type": "string", "enum": ["OK", "DEGRADED", "FAILED", "NOT_APPLICABLE"] },
    "observations": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk_level": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "constraints": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "suggested_next_step": { "type": ["string", "null"] },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "receipt": { "type": ["object", "null"] }
  },
  "not": {
    "anyOf": [
      { "required": ["final_answer"] },
      { "required": ["response_to_user"] }
    ]
  }
}
