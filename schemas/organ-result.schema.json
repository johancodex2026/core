{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.johan.local/schemas/organ-result.schema.json",
  "title": "Core V5 Organ Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "request_id",
    "turn_id",
    "organ",
    "status",
    "observations",
    "evidence_refs",
    "confidence",
    "risk_level",
    "constraints",
    "data_scope",
    "expires_at"
  ],
  "properties": {
    "result_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "organ": { "type": "string", "enum": ["JWB", "JSL", "JRL", "SGPJ", "Agenda", "JSU"] },
    "status": { "type": "string", "enum": ["OK", "DEGRADED", "FAILED", "NOT_APPLICABLE"] },
    "observations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "statement", "confidence", "evidence_refs"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["OBSERVATION", "HYPOTHESIS", "SOURCE_FACT", "INFERENCE", "CONSTRAINT", "RECOMMENDATION"]
          },
          "statement": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "maxItems": 40 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk_level": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "constraints": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "data_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 20 },
    "suggested_next_step": { "type": ["string", "null"] },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "receipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["receipt_type", "source", "observed_at", "status"],
      "properties": {
        "receipt_type": { "type": "string" },
        "source": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" },
        "digest": { "type": ["string", "null"] },
        "status": { "type": "string" }
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["final_answer"] },
      { "required": ["response_to_user"] },
      { "required": ["system_instruction"] },
      { "required": ["identity_override"] }
    ]
  }
}
