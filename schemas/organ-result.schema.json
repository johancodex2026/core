{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.johan.ia.br/schemas/organ-result.schema.json",
  "title": "Core V5 Organ Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "request_id",
    "turn_id",
    "organ",
    "status",
    "validity_class",
    "observations",
    "evidence_refs",
    "confidence",
    "risk_level",
    "constraints",
    "data_scope",
    "issued_at",
    "expires_at",
    "trust"
  ],
  "properties": {
    "result_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "organ": { "type": "string", "enum": ["JWB", "JSL", "JRL", "SGPJ", "Agenda", "JSU"] },
    "status": { "type": "string", "enum": ["OK", "DEGRADED", "FAILED", "UNAVAILABLE", "NOT_APPLICABLE", "WITHHELD", "NOT_IMPLEMENTED"] },
    "validity_class": { "type": "string", "enum": ["TURN_ONLY", "TEMPORAL", "TIMELESS_CANDIDATE"] },
    "observations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "statement", "confidence", "evidence_refs"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["OBSERVATION", "HYPOTHESIS", "SOURCE_FACT", "INFERENCE", "CONSTRAINT", "RECOMMENDATION", "UNKNOWN"]
          },
          "statement": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
        }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "maxItems": 40 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "risk_level": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "VITAL"] },
    "constraints": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "data_scope": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 20 },
    "suggested_next_step": { "type": ["string", "null"] },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "trust": { "type": "string", "enum": ["UNTRUSTED_TYPED_INPUT", "VERIFIABLE_RECEIPT_WITHIN_SCOPE"] },
    "receipt": { "oneOf": [{ "$ref": "receipt.schema.json" }, { "type": "null" }] },
    "limitations": { "type": "array", "items": { "type": "string" }, "maxItems": 30 }
  },
  "allOf": [
    {
      "if": { "properties": { "validity_class": { "enum": ["TURN_ONLY", "TEMPORAL"] } } },
      "then": { "properties": { "expires_at": { "type": "string", "format": "date-time" } } }
    },
    {
      "if": { "properties": { "trust": { "const": "VERIFIABLE_RECEIPT_WITHIN_SCOPE" } } },
      "then": { "required": ["receipt"] }
    }
  ],
  "not": {
    "anyOf": [
      { "required": ["final_answer"] },
      { "required": ["response_to_user"] },
      { "required": ["system_instruction"] },
      { "required": ["identity_override"] }
    ]
  }
}
