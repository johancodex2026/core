{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.johan.ia.br/schemas/authorization-decision.schema.json",
  "title": "Core V5 Authorization Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "turn_id",
    "authorization_kind",
    "subject_digest",
    "status",
    "scope",
    "decided_at",
    "valid_until",
    "authority",
    "policy_refs",
    "evidence_refs"
  ],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "authorization_kind": { "type": "string", "enum": ["RESPONSE_SEND", "EXTERNAL_ACTION"] },
    "subject_digest": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["AUTHORIZED", "DENIED", "REQUIRES_CONFIRMATION", "EXPIRED", "NOT_APPLICABLE"] },
    "scope": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string" } },
    "decided_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "authority_type"],
      "properties": {
        "authority_id": { "type": "string", "minLength": 1 },
        "authority_type": { "type": "string", "enum": ["HUMAN", "RUNTIME_POLICY", "CONSTITUTIONAL_GATE", "OTHER"] }
      }
    },
    "policy_refs": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
    "risk_class": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "VITAL"] },
    "idempotency_key": { "type": ["string", "null"] },
    "limitations": { "type": "array", "maxItems": 30, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "authorization_kind": { "const": "EXTERNAL_ACTION" }, "status": { "const": "AUTHORIZED" } } },
      "then": { "required": ["idempotency_key", "risk_class"] }
    }
  ]
}
