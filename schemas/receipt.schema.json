{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.johan.ia.br/schemas/receipt.schema.json",
  "title": "Core V5 Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "receipt_version",
    "receipt_type",
    "subject",
    "domain",
    "source",
    "observed_at",
    "issued_at",
    "status",
    "scope",
    "privacy",
    "limitations"
  ],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "receipt_version": { "type": "string", "minLength": 1 },
    "receipt_type": {
      "type": "string",
      "enum": [
        "IDENTITY_LOAD",
        "SOURCE_READ",
        "EXECUTION",
        "VALIDATION",
        "PERSISTENCE",
        "RENDER_TRANSFORM",
        "SEND",
        "DELIVERY",
        "READ",
        "ROLLBACK",
        "PROMOTION",
        "OTHER"
      ]
    },
    "subject": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "source": { "$ref": "source-reference.schema.json" },
    "observed_at": { "type": "string", "format": "date-time" },
    "issued_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "status": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "NOT_APPLICABLE",
        "UNAVAILABLE",
        "WITHHELD",
        "NOT_IMPLEMENTED",
        "PLANNED",
        "READY",
        "QUEUED",
        "ACCEPTED",
        "EXECUTING",
        "EXECUTED",
        "VERIFIED",
        "RENDERED",
        "SEND_AUTHORIZED",
        "SENT",
        "DELIVERED",
        "READ",
        "PROMOTED",
        "PARTIAL",
        "FAILED",
        "EXPIRED",
        "REJECTED",
        "SUPERSEDED",
        "ROLLED_BACK"
      ]
    },
    "scope": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string" } },
    "object_digest": { "type": ["string", "null"] },
    "previous_receipt_refs": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
    "privacy": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "PRIVATE", "SENSITIVE"] },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "enum": ["NONE", "HASH", "SIGNATURE", "PROVIDER_ASSERTION", "OTHER"] },
        "digest": { "type": ["string", "null"] },
        "signature_ref": { "type": ["string", "null"] }
      }
    },
    "limitations": { "type": "array", "maxItems": 30, "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt_type": { "enum": ["IDENTITY_LOAD", "RENDER_TRANSFORM", "SEND", "DELIVERY", "VALIDATION", "PROMOTION"] }
        }
      },
      "then": { "required": ["object_digest"] }
    },
    {
      "if": {
        "properties": {
          "receipt_type": { "enum": ["SOURCE_READ", "EXECUTION", "SEND", "DELIVERY", "PERSISTENCE"] }
        }
      },
      "then": { "required": ["valid_until"] }
    }
  ]
}
