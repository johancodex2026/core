{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core.johan.ia.br/schemas/receipt.schema.json",
  "title": "Core V5 Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "receipt_version",
    "receipt_type",
    "subject",
    "domain",
    "source",
    "observed_at",
    "issued_at",
    "status",
    "scope",
    "privacy",
    "integrity",
    "limitations"
  ],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "receipt_version": { "type": "string", "minLength": 1 },
    "receipt_type": {
      "type": "string",
      "enum": [
        "IDENTITY_LOAD",
        "SOURCE_READ",
        "EXECUTION",
        "VALIDATION",
        "PERSISTENCE",
        "RENDER_TRANSFORM",
        "SEND",
        "DELIVERY",
        "READ",
        "ROLLBACK",
        "PROMOTION"
      ]
    },
    "subject": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "source": { "$ref": "source-reference.schema.json" },
    "observed_at": { "type": "string", "format": "date-time" },
    "issued_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "status": {
      "type": "string",
      "enum": [
        "DELIVERED",
        "EXECUTED",
        "EXPIRED",
        "FAILED",
        "PARTIAL",
        "PROMOTED",
        "READ",
        "REJECTED",
        "RENDERED",
        "ROLLED_BACK",
        "SENT",
        "UNKNOWN",
        "UNAVAILABLE",
        "VERIFIED",
        "WITHHELD"
      ]
    },
    "scope": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string" } },
    "object_digest": {
      "anyOf": [
        { "$ref": "digest-reference.schema.json" },
        { "type": "null" }
      ]
    },
    "previous_receipt_refs": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
    "privacy": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "PRIVATE", "SENSITIVE"] },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "enum": ["NONE", "HASH", "SIGNATURE", "PROVIDER_ASSERTION"] },
        "digest": {
          "anyOf": [
            { "$ref": "digest-reference.schema.json" },
            { "type": "null" }
          ]
        },
        "signature_ref": { "type": ["string", "null"] }
      }
    },
    "limitations": { "type": "array", "maxItems": 30, "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"IDENTITY_LOAD"}}},"then":{"properties":{"status":{"enum":["VERIFIED","FAILED","EXPIRED"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"SOURCE_READ"}}},"then":{"properties":{"status":{"enum":["VERIFIED","PARTIAL","FAILED","UNAVAILABLE","WITHHELD","EXPIRED"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"EXECUTION"}}},"then":{"properties":{"status":{"enum":["EXECUTED","PARTIAL","FAILED"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"VALIDATION"}}},"then":{"properties":{"status":{"enum":["VERIFIED","PARTIAL","FAILED"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"PERSISTENCE"}}},"then":{"properties":{"status":{"enum":["VERIFIED","PARTIAL","FAILED"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"RENDER_TRANSFORM"}}},"then":{"properties":{"status":{"enum":["RENDERED","FAILED"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"SEND"}}},"then":{"properties":{"status":{"enum":["SENT","FAILED"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"DELIVERY"}}},"then":{"properties":{"status":{"enum":["DELIVERED","UNKNOWN","FAILED","EXPIRED"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"READ"}}},"then":{"properties":{"status":{"enum":["READ","UNKNOWN"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"ROLLBACK"}}},"then":{"properties":{"status":{"enum":["ROLLED_BACK","PARTIAL","FAILED"]}}}},
    {"if":{"required":["receipt_type"],"properties":{"receipt_type":{"const":"PROMOTION"}}},"then":{"properties":{"status":{"enum":["PROMOTED","REJECTED","FAILED"]}}}},
    {
      "if": {
        "required": ["receipt_type"],
        "properties": {"receipt_type": {"enum": ["IDENTITY_LOAD", "RENDER_TRANSFORM", "SEND", "DELIVERY", "VALIDATION", "PROMOTION"]}}
      },
      "then": {
        "required": ["object_digest"],
        "properties": {"object_digest": {"$ref": "digest-reference.schema.json"}}
      }
    },
    {
      "if": {
        "required": ["receipt_type"],
        "properties": {"receipt_type": {"enum": ["SOURCE_READ", "SEND", "DELIVERY"]}}
      },
      "then": {
        "required": ["valid_until"],
        "properties": {"valid_until": {"type": "string", "format": "date-time"}}
      }
    }
  ]
}
